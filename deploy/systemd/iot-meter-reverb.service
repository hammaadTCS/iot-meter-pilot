[Unit]
Description=IoT Meter Reverb WebSocket Server
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/iot-meter-pilot
ExecStart=/usr/bin/php artisan reverb:start

# Why this must be supervised rather than started by hand: every alert notification is
# broadcast through Reverb. While it was unreachable between 2026-08-01 and 2026-08-28,
# 574 notification jobs failed and were discarded. An unreachable websocket server does
# not degrade the product visibly — it silently stops users being told anything.
#
# Binds REVERB_SERVER_PORT (8080 by default). Keep that port free: on the development
# machine phpMyAdmin was moved to 8081 in 2026-08 precisely because it had taken 8080
# and Reverb could not start.
Restart=always
RestartSec=5

KillSignal=SIGTERM
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=iot-meter-reverb

MemoryMax=256M

[Install]
WantedBy=multi-user.target
